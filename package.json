{
  "name": "dsh-shared-config",
  "version": "0.1.2",
  "description": "Shared native configuration for DSH profiles using the same home directory.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "packageManager": "pnpm@12.17.0",
  "keywords": ["dsh", "cordis", "configuration", "shared-config"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --project tsconfig.host.json --noEmit",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "test:package": "pnpm pack --out dist/dsh-shared-config.tgz && node scripts/verify-package.mjs dist/dsh-shared-config.tgz",
    "check": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run test:package",
    "prepack": "pnpm run build"
  },
  "files": ["lib/", "locale/", "icon.svg", "cordis.patch.yml", "README.md", "docs/RELEASING.md", "LICENSE"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.1",
    "@deepseek-ai/dsh-config-editor": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-hmr": "0.2.2-alpha.2"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.1",
    "@deepseek-ai/dsh-config-editor": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-hmr": "0.2.2-alpha.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
